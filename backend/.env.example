# Copy this file to .env and fill in real values before deploying.
# Everything here has a safe default for local development except the two marked REQUIRED.

# --- General ---
APP_NAME=LPU Campus Assistant
ENVIRONMENT=development        # development | production | test
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:5173
ENABLED_ASSISTANTS=university,placement

# --- Security ---
# REQUIRED in production: 32+ random bytes, e.g. `openssl rand -hex 32`
SECRET_KEY=dev-only-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480
# REQUIRED in production: password for every seeded demo account (admin + students)
DEMO_PASSWORD=campus@123
CHAT_RATE_LIMIT_PER_MINUTE=20
LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- Storage ---
DATABASE_URL=sqlite:///var/campus.db
VECTOR_DIR=var/chroma
AUTO_SEED=true
AUTO_INGEST=true

# --- Retrieval ---
# "hash" needs no model download and works offline; use it for a first run or CI.
# Switch to "sentence-transformers" for real multilingual retrieval quality.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RETRIEVAL_TOP_K=5
# Leave unset to use the model-specific default in app/config.py. Run
# `python -m app.cli.calibrate` after changing the embedding model.
MIN_RETRIEVAL_SCORE=

# --- Language model (any OpenAI-compatible /chat/completions endpoint) ---
# Leave LLM_BASE_URL empty to run in extractive mode (no generation, passages only).
#
# Gemini (OpenAI-compatible endpoint, free tier):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.5-flash
#   LLM_API_KEY=your-google-ai-studio-key
#
# Groq (free tier, very fast):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
#   LLM_API_KEY=your-groq-key
#
# Ollama (fully local, needs a GPU or a patient CPU):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.1
#   LLM_API_KEY=ollama
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# --- Placement policy ---
# Keep this in sync with data/docs/placement/placement_policy_2026.pdf section 6.
PLACEMENT_OFFER_MULTIPLIER=1.5
